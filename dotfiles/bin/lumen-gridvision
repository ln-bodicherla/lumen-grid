#!/bin/bash
# Grid vision: tint the screen to shades of the theme text color (the ice-blue white on
# Program, cream on Overload, pale red on Redline) while one of your chosen apps is focused. The lumen-fx shell plugin
# switches it automatically from ~/.config/omarchy/lumen-vision.json
#   { "auto": true, "apps": ["org.gnome.Nautilus", ...] }       (window classes)
# which the eye icon in the bar edits. This script writes the shader and flips the switch.
#
#   lumen-gridvision [toggle|on|off]   turn auto mode on / off (the bar icon does the same)
#   lumen-gridvision write             (re)write the shader for the current theme
#   lumen-gridvision refresh           rewrite and re-apply if it's showing (theme-set hook)
#   lumen-gridvision test              tint the whole screen for 5 seconds
#
# The color mapping matches the terminal's one-color shader (os/make-ghostty-glow.sh).
set -euo pipefail

STATE="$HOME/.local/state/lumen"
CONFIG="$HOME/.config/omarchy/lumen-vision.json"
SHADER="$STATE/gridvision.glsl"
COLORS="$HOME/.local/state/omarchy/current/theme/colors.toml"

write_shader() {
  local hex rgb
  # the theme's text color (the whitish ice-blue / cream you see in Ghostty), not the accent
  hex=$(grep -E '^foreground[[:space:]]*=' "$COLORS" 2>/dev/null | head -1 | sed -E 's/.*"#([0-9A-Fa-f]{6})".*/\1/')
  hex=${hex:-d6f4fa}
  rgb=$(awk -v r=$((16#${hex:0:2})) -v g=$((16#${hex:2:2})) -v b=$((16#${hex:4:2})) 'BEGIN { printf "%.3f, %.3f, %.3f", r / 255, g / 255, b / 255 }')
  mkdir -p "$STATE"
  cat > "$SHADER" <<EOF
#version 300 es
// Lumen grid vision (generated by lumen-gridvision; theme text color #$hex)
precision highp float;
in vec2 v_texcoord;
uniform sampler2D tex;
layout(location = 0) out vec4 fragColor;

const vec3 ACCENT = vec3($rgb);   // theme text color

void main() {
  vec4 c = texture(tex, v_texcoord);
  float lum = max(dot(c.rgb, vec3(0.2126, 0.7152, 0.0722)), max(c.r, max(c.g, c.b)) * 0.6);
  vec3 tint = ACCENT * clamp(lum * 1.25, 0.0, 1.0);
  tint = mix(tint, vec3(1.0), smoothstep(0.82, 1.0, lum) * 0.45);
  // keep near-blacks neutral so dark backgrounds don't turn into a colored haze
  fragColor = vec4(mix(c.rgb, tint, smoothstep(0.11, 0.2, lum)), c.a);
}
EOF
}

apply() { hyprctl eval "hl.config({ decoration = { screen_shader = \"$1\" } })" >/dev/null; }

set_auto() {   # write the auto flag, keeping the app list
  mkdir -p "$(dirname "$CONFIG")"
  python3 - "$CONFIG" "$1" <<'EOF'
import json, sys
path, on = sys.argv[1], sys.argv[2] == "on"
try:
    cfg = json.load(open(path))
except (OSError, ValueError):
    cfg = {"apps": []}
cfg["auto"] = on
json.dump(cfg, open(path, "w"), indent=2)
EOF
}

case "${1:-toggle}" in
  write)   write_shader ;;
  on)      write_shader; set_auto on; notify-send -a Lumen -t 1500 "◆ GRID VISION" "auto: on for your chosen apps" ;;
  off)     set_auto off; apply ""; notify-send -a Lumen -t 1500 "◆ GRID VISION" "offline" ;;
  toggle)  if python3 -c "import json,sys; sys.exit(0 if json.load(open('$CONFIG')).get('auto') else 1)" 2>/dev/null; then "$0" off; else "$0" on; fi ;;
  refresh) write_shader
           [[ $(hyprctl getoption decoration:screen_shader 2>/dev/null | head -1) == *gridvision* ]] && { apply ""; apply "$SHADER"; } ;;
  test)    write_shader; apply "$SHADER"; sleep 5; apply "" ;;
  *)       echo "usage: lumen-gridvision [toggle|on|off|write|refresh|test]" >&2; exit 1 ;;
esac
exit 0
