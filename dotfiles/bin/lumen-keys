#!/usr/bin/env python3
"""Lumen keyboard: the MacBook keyboard backlight reacts to the grid.

- Breathes while a Claude Code session is waiting for you (lumen-agent-state).
- Flashes once for each new notification.

It always returns to the brightness you set, follows you when you change it
(Fn keys, settings), and stays dark if you turned the backlight off.
Runs as the lumen-keys user service.
"""
import glob
import math
import os
import subprocess
import threading
import time

def find_led():
    """the keyboard backlight LED, e.g. kbd_backlight or tpacpi::kbd_backlight"""
    for p in sorted(glob.glob("/sys/class/leds/*kbd_backlight*")):
        return os.path.basename(p)
    return None


LED = find_led()
SYS = f"/sys/class/leds/{LED}"
AGENT_STATE = os.path.expanduser("~/.local/bin/lumen-agent-state")
FPS = 25
BREATH_SECONDS = 2.6      # one full breath
BREATH_FLOOR = 0.15       # dimmest point of a breath, as a fraction of your level
FLASH_SECONDS = 0.45

flash_at = 0.0            # time of the last notification


def read(name):
    with open(f"{SYS}/{name}") as f:
        return int(f.read())


def write(value):
    # logind lets the session user set LED brightness without root
    subprocess.run(["busctl", "call", "org.freedesktop.login1", "/org/freedesktop/login1/session/auto",
                    "org.freedesktop.login1.Session", "SetBrightness", "ssu", "leds", LED, str(int(value))],
                   stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)


def watch_notifications():
    global flash_at
    cmd = ["dbus-monitor", "--session", "type='method_call',interface='org.freedesktop.Notifications',member='Notify'"]
    while True:
        with subprocess.Popen(cmd, stdout=subprocess.PIPE, text=True) as proc:
            for line in proc.stdout:
                if "member=Notify" in line:
                    flash_at = time.monotonic()
        time.sleep(2)


def agent_waiting():
    try:
        out = subprocess.run([AGENT_STATE, "status"], capture_output=True, text=True, timeout=2).stdout
        return out.strip() == "wait"
    except Exception:
        return False


def main():
    if not LED:
        return   # no keyboard backlight on this machine: nothing to do
    threading.Thread(target=watch_notifications, daemon=True).start()
    peak = read("max_brightness")
    base = read("brightness")     # your level
    written = base                # what we last set
    waiting, next_poll = False, 0.0
    t0 = time.monotonic()

    while True:
        now = time.monotonic()
        current = read("brightness")
        if current != written:    # you changed it: that's the new level
            base = written = current

        if now >= next_poll:
            waiting, next_poll = agent_waiting(), now + 0.5

        target = base
        if base > 0:
            if waiting:
                phase = (now - t0) / BREATH_SECONDS * 2 * math.pi
                target = base * (BREATH_FLOOR + (1 - BREATH_FLOOR) * (0.5 + 0.5 * math.cos(phase)))
            since = now - flash_at
            if since < FLASH_SECONDS:
                # snap to full and ease back; if you already run it near full,
                # blink dark instead so the flash still shows
                k = 1 - since / FLASH_SECONDS
                if base > peak * 0.7:
                    target = target * (1 - 0.9 * k * k)
                else:
                    target = target + (peak - target) * k * k

        target = round(max(0, min(peak, target)))
        if target != written:
            write(target)
            written = target
        time.sleep(1 / FPS)


if __name__ == "__main__":
    main()
